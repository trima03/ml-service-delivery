{
  "title": "Demand Forecast API",
  "uid": "demand-forecast-api",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {"id": 1, "title": "HTTP requests / second", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum by (handler) (rate(http_requests_total{job=\"demand-forecast-api\"}[5m]))", "legendFormat": "{{handler}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "datasource": {"type": "prometheus", "uid": "prometheus"}},
    {"id": 2, "title": "p95 request duration", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"demand-forecast-api\"}[5m])))", "legendFormat": "p95", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "datasource": {"type": "prometheus", "uid": "prometheus"}},
    {"id": 3, "title": "HTTP 5xx rate", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "sum(rate(http_requests_total{job=\"demand-forecast-api\", status=~\"5..\"}[5m]))", "legendFormat": "errors/s", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "datasource": {"type": "prometheus", "uid": "prometheus"}},
    {"id": 4, "title": "Successful forecasts", "type": "stat", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "sum(forecast_predictions_total)", "legendFormat": "forecasts", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "datasource": {"type": "prometheus", "uid": "prometheus"}}
  ],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "annotations": {"list": []},
  "links": []
}
